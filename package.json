{
  "name": "survive-fortress",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "dev": "turbo watch build dev",
    "build": "turbo build",
    "editor": "turbo watch build dev --filter=@repo/editor-server --filter=@repo/editor",
    "dev:kill": "lsof -ti :5173 -ti :5174 -ti :5175 | xargs kill -9 2>/dev/null; echo 'Dev servers killed'"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "turbo": "^2.9.6",
    "typescript": "^5.8.0",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.1.0"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  }
}

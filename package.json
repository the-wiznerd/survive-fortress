{
  "name": "survive-fortress",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "yarn workspace @sf/engine test",
    "test:watch": "yarn workspace @sf/engine test:watch",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "dev": "yarn workspace @sf/client dev",
    "build": "yarn workspace @sf/client build",
    "dev:kill": "lsof -ti :5173 -ti :5174 -ti :5175 | xargs kill -9 2>/dev/null; echo 'Dev servers killed'",
    "generate": "yarn workspaces foreach -A run generate"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  },
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=22"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "~engine/*": ["../engine/src/*"]
    }
  },
  "include": ["src", "../engine/src/types.d.ts", "../engine/auto-imports.d.ts"]
}
